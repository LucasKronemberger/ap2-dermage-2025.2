<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/fundobranco"
    tools:context=".ResultadoActivity">

    <LinearLayout
        android:id="@+id/main_content_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- CABEÇALHO -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ondalaranja"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/onda_laranjatopo" />
            <ImageView
                android:id="@+id/logo"
                android:layout_width="180dp"
                android:layout_height="100dp"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="@+id/ondalaranja"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/dermagelogotype" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp">

            <TextView
                android:id="@+id/tv_titulo_resultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aqui estão seus resultados!"
                android:textSize="24sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/roboto_bold"
                android:textAlignment="center"/>

            <!-- 1. HIDRATAÇÃO (Vermelho) -->
            <TextView
                android:id="@+id/label_hidratacao"
                android:text="Hidratação"
                android:layout_marginTop="24dp"
                style="@style/LabelResultado"/>
            <SeekBar
                android:id="@+id/slider_hidratacao"
                style="@style/SeekBarResultado"
                android:progressTint="#E53935"
                android:thumbTint="#E53935"/>

            <!-- 2. ACNE (Laranja) -->
            <TextView
                android:id="@+id/label_acne"
                android:text="Acne"
                android:layout_marginTop="12dp"
                style="@style/LabelResultado"/>
            <SeekBar
                android:id="@+id/slider_acne"
                style="@style/SeekBarResultado"
                android:progressTint="#FB8C00"
                android:thumbTint="#FB8C00"/>

            <!-- 3. MANCHAS (Verde) -->
            <TextView
                android:id="@+id/label_manchas"
                android:text="Manchas"
                android:layout_marginTop="12dp"
                style="@style/LabelResultado"/>
            <SeekBar
                android:id="@+id/slider_manchas"
                style="@style/SeekBarResultado"
                android:progressTint="#43A047"
                android:thumbTint="#43A047"/>

            <!-- 4. RUGAS (Rosa Dermage) -->
            <TextView
                android:id="@+id/label_rugas"
                android:text="Rugas"
                android:layout_marginTop="12dp"
                style="@style/LabelResultado"/>
            <SeekBar
                android:id="@+id/slider_rugas"
                style="@style/SeekBarResultado"
                android:progressTint="@color/dermage_pink"
                android:thumbTint="@color/dermage_pink"/>

            <!-- 5. OLEOSIDADE (Cinza Escuro) -->
            <TextView
                android:id="@+id/label_oleosidade"
                android:text="Oleosidade"
                android:layout_marginTop="12dp"
                style="@style/LabelResultado"/>
            <SeekBar
                android:id="@+id/slider_oleosidade"
                style="@style/SeekBarResultado"
                android:progressTint="#616161"
                android:thumbTint="#616161"/>

            <!-- CARD DIAGNÓSTICO (Estilo Novo) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#EEEEEE"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:text="PRINCIPAIS PREOCUPAÇÕES"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/roboto_bold"/>

                    <TextView
                        android:id="@+id/tv_concerns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Carregando diagnóstico..."
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="@font/roboto_regular"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Ganhe 15% OFF\nnas compras acima de R$200"
                android:textSize="20sp"
                android:textAlignment="center"
                android:textColor="#4CAF50"
                android:fontFamily="@font/roboto_bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_comprar_rotina"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="COMPRAR ROTINA"
                    app:backgroundTint="#F39A08"
                    app:cornerRadius="24dp"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/roboto_bold"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_home"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="Voltar para Home"
                    android:textColor="#F39A08"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="#F39A08"
                    app:cornerRadius="24dp"
                    android:fontFamily="@font/roboto_bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confira sua rotina\npersonalizada"
                android:textSize="22sp"
                android:textAlignment="center"
                android:textColor="@android:color/black"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginTop="40dp"/>

            <!-- ABAS MANHÃ / NOITE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_manha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MANHÃ"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/dermage_pink"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="4dp"
                    app:icon="@drawable/ic_sun"
                    app:iconGravity="textStart"
                    android:fontFamily="@font/roboto_bold"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_noite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NOITE"
                    android:textColor="@color/dermage_pink"
                    app:backgroundTint="#F0F0F0"
                    app:strokeColor="@color/dermage_pink"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    android:layout_marginStart="4dp"
                    app:icon="@drawable/ic_moon"
                    app:iconGravity="textStart"
                    app:iconTint="@color/dermage_pink"
                    android:fontFamily="@font/roboto_bold"/>
            </LinearLayout>

            <!-- LISTAS -->
            <LinearLayout
                android:id="@+id/container_rotina_manha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:background="#FAFAFA"
                android:visibility="visible">
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_rotina_noite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:background="#FAFAFA"
                android:visibility="gone">
            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitEnd"
            android:src="@drawable/footer_fundo" />

    </LinearLayout>
</ScrollView>