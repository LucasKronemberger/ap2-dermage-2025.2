<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".ResultadoActivity">

    <LinearLayout
        android:id="@+id/main_content_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/header_topo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_titulo_resultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sabrina, aqui estão seus resultados."
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:fontFamily="@font/cambay_bold"
                android:textAlignment="center"/>

            <TextView
                android:id="@+id/label_acne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acne"
                android:layout_marginTop="32dp"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:fontFamily="@font/cambay_regular"/>
            <SeekBar
                android:id="@+id/slider_acne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"/>

            <TextView
                android:id="@+id/label_hidratacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hidratação"
                android:layout_marginTop="16dp"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:fontFamily="@font/cambay_regular"/>
            <SeekBar
                android:id="@+id/slider_hidratacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"/>

            <TextView
                android:id="@+id/label_manchas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manchas"
                android:layout_marginTop="16dp"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:fontFamily="@font/cambay_regular"/>
            <SeekBar
                android:id="@+id/slider_manchas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"/>

            <TextView
                android:id="@+id/label_rugas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rugas"
                android:layout_marginTop="16dp"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:fontFamily="@font/cambay_regular"/>
            <SeekBar
                android:id="@+id/slider_rugas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"/>
            <TextView
                android:id="@+id/label_poros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Poros"
                android:layout_marginTop="16dp"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:fontFamily="@font/cambay_regular"/>
            <SeekBar
                android:id="@+id/slider_poros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"/>




            <View android:layout_width="match_parent" android:layout_height="24dp" />
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#F0F0F0">
                <TextView
                    android:id="@+id/tv_concerns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    tools:text="PRINCIPAIS PREOCUPAÇÕES..."
                    android:textColor="@android:color/black"
                    android:fontFamily="@font/cambay_regular"/>
            </androidx.cardview.widget.CardView>


            <View android:layout_width="match_parent" android:layout_height="24dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ganhe 15 % nas compras acima\nde R$200"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="@android:color/black"
                android:fontFamily="@font/cambay_bold"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="24dp">
                <Button
                    android:id="@+id/btn_comprar_rotina"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="200dp"
                    android:text="COMPRAR ROTINA"
                    android:backgroundTint="#FF9800"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/cambay_bold"/>
                <Button
                    android:id="@+id/btn_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="200dp"
                    android:layout_marginTop="16dp"
                    android:text="Home"
                    android:backgroundTint="#FF9800"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/cambay_bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confira sua rotina\npersonalizada"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="@android:color/black"
                android:fontFamily="@font/cambay_bold"
                android:layout_marginTop="60dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="24dp">
                <Button
                    android:id="@+id/btn_manha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MANHÃ"
                    android:textColor="@android:color/black"
                    android:backgroundTint="@android:color/white"
                    app:strokeColor="@android:color/darker_gray"
                    app:strokeWidth="1dp"
                    android:drawableStart="@drawable/ic_sun"
                    android:fontFamily="@font/cambay_bold"
                    android:layout_marginEnd="8dp"/>
                <Button
                    android:id="@+id/btn_noite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NOITE"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/dermage_pink"
                    android:drawableStart="@drawable/ic_moon"
                    android:fontFamily="@font/cambay_bold"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/container_rotina_manha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/container_rotina_noite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitEnd"
            android:src="@drawable/footer_fundo" />

    </LinearLayout>
</ScrollView>